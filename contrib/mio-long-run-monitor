#!/usr/bin/env bash
set -euo pipefail

interval=60
output=/tmp/mio-long-run.tsv
pid=

usage() {
    printf '%s\n' \
        'Usage: mio-long-run-monitor [--pid PID] [--interval SECONDS] [--output PATH]' \
        '' \
        'Monitors a running mio-compositor process through /proc.' \
        'When --pid is omitted, the newest mio-compositor process is selected.'
}

while (($# > 0)); do
    case "$1" in
        --pid)
            (($# >= 2)) || { printf '%s\n' 'missing value for --pid' >&2; exit 2; }
            pid=$2
            shift 2
            ;;
        --interval)
            (($# >= 2)) || { printf '%s\n' 'missing value for --interval' >&2; exit 2; }
            interval=$2
            shift 2
            ;;
        --output)
            (($# >= 2)) || { printf '%s\n' 'missing value for --output' >&2; exit 2; }
            output=$2
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            printf 'unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

[[ $interval =~ ^[1-9][0-9]*$ ]] || {
    printf 'invalid interval: %s\n' "$interval" >&2
    exit 2
}

if [[ -z $pid ]]; then
    pid=$(pgrep -n -x mio-compositor || true)
fi
[[ $pid =~ ^[1-9][0-9]*$ ]] || {
    printf '%s\n' 'mio-compositor is not running; pass its PID with --pid' >&2
    exit 1
}
[[ -r /proc/$pid/status ]] || {
    printf 'cannot read /proc/%s/status\n' "$pid" >&2
    exit 1
}

if [[ ! -s $output ]]; then
    printf '%s\n' 'timestamp	elapsed_s	pid	rss_kib	vm_kib	threads	fds' >> "$output"
fi

started=$(date +%s)
printf 'monitoring mio-compositor pid=%s every %ss; output=%s\n' "$pid" "$interval" "$output"

while [[ -r /proc/$pid/status ]]; do
    now=$(date +%s)
    timestamp=$(date --iso-8601=seconds)
    rss_kib=$(awk '$1 == "VmRSS:" { print $2 }' "/proc/$pid/status")
    vm_kib=$(awk '$1 == "VmSize:" { print $2 }' "/proc/$pid/status")
    threads=$(awk '$1 == "Threads:" { print $2 }' "/proc/$pid/status")
    fds=$(find "/proc/$pid/fd" -mindepth 1 -maxdepth 1 -printf '.' 2>/dev/null | wc -c)
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$timestamp" "$((now - started))" "$pid" \
        "${rss_kib:-0}" "${vm_kib:-0}" "${threads:-0}" "$fds" >> "$output"
    sleep "$interval"
done

printf 'mio-compositor pid=%s exited; samples remain in %s\n' "$pid" "$output"
